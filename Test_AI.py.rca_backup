from pathlib import Path
import py_compile
import re


def main():
    path = Path("Test_AI.py")
    if not path.is_file():
        raise FileNotFoundError(
            "Test_AI.py not found. Run this updater from the Agent_AUTOMATION_AI folder."
        )

    original = path.read_text(encoding="utf-8")
    backup = Path("Test_AI.py.rca_backup")
    backup.write_text(original, encoding="utf-8")
    text = original

    # 1. Remove RCA calls from the recovery loop. RCA should print only once at the end.
    text = re.sub(
        r"\n[ \t]+print_root_cause_analysis\(\s*failure_analysis\s*\)",
        "",
        text,
    )

    # 2. Remove an existing RCA helper if it is placed after main().
    main_guard_index = text.find('if __name__ == "__main__":')
    misplaced_index = text.find(
        "def print_root_cause_analysis(",
        text.find("def main("),
    )

    if (
        misplaced_index != -1
        and main_guard_index != -1
        and misplaced_index < main_guard_index
    ):
        helper_end = text.find("\nif __name__ ==", misplaced_index)
        if helper_end != -1:
            text = text[:misplaced_index] + text[helper_end + 1:]

    # 3. Add the RCA helper before main() if it is not already defined there.
    main_index = text.find("def main(")
    helper_index = text.find("def print_root_cause_analysis(")

    if helper_index == -1 or helper_index > main_index:
        helper = '''# ==================================================
# ROOT CAUSE ANALYSIS PRINTING
# ==================================================
def print_root_cause_analysis(failure_analysis):
    category = str(failure_analysis.get("category", "UNKNOWN"))
    error_type = str(failure_analysis.get("error_type", "Unknown Error"))
    missing_locator = str(failure_analysis.get("missing_locator", "Unknown"))
    root_cause = str(
        failure_analysis.get(
            "root_cause",
            "Root cause was not identified.",
        )
    )
    impact = str(
        failure_analysis.get(
            "impact",
            "Impact was not identified.",
        )
    )
    suggested_fix = str(
        failure_analysis.get(
            "suggested_fix",
            "No suggested fix is available.",
        )
    )
    recommendation = str(
        failure_analysis.get(
            "recommendation",
            "No recommendation is available.",
        )
    )
    confidence = str(failure_analysis.get("confidence", "Unknown"))

    lines = [
        "",
        "========================================",
        "         ROOT CAUSE ANALYSIS",
        "========================================",
        f"Category        : {category}",
        f"Error Type      : {error_type}",
    ]

    if missing_locator.lower() not in {
        "",
        "unknown",
        "none",
        "null",
        "n/a",
    }:
        lines.append(f"Missing Locator : {missing_locator}")

    lines.extend(
        [
            f"Root Cause      : {root_cause}",
            f"Impact          : {impact}",
            f"Suggested Fix   : {suggested_fix}",
            f"Recommendation  : {recommendation}",
            f"Confidence      : {confidence}",
            "========================================",
        ]
    )

    print_pink("\\n".join(lines))


'''
        if main_index == -1:
            raise RuntimeError("main() function was not found.")
        text = text[:main_index] + helper + text[main_index:]

    # 4. Ensure final_failure_analysis always exists.
    text = text.replace(
        "    jira_result = None\n    if final_status == \"FAILED\":",
        "    jira_result = None\n    final_failure_analysis = None\n\n"
        "    if final_status == \"FAILED\":",
        1,
    )

    # 5. Print RCA once after notification and before report opening.
    if "# FINAL ROOT CAUSE ANALYSIS" not in text:
        report_open_pattern = re.compile(
            r"(\n\s{4}report_opened\s*=\s*execution_agent\.open_playwright_report\()",
            flags=re.MULTILINE,
        )
        final_rca = '''

    # ==================================================
    # FINAL ROOT CAUSE ANALYSIS
    # ==================================================
    if final_failure_analysis:
        print_root_cause_analysis(final_failure_analysis)

    if final_status == "PASSED":
        print_success("\\n===== OVERALL STATUS: PASSED =====")
    else:
        print_error("\\n===== OVERALL STATUS: FAILED =====")

    print_info("\\nAll framework processing completed.")

'''
        text, count = report_open_pattern.subn(
            lambda match: final_rca + match.group(1),
            text,
            count=1,
        )
        if count != 1:
            raise RuntimeError(
                "Could not find the final report-opening block."
            )

    # 6. Replace the HTML anchor accidentally pasted as the report URL.
    text = re.sub(
        r'print_info\("<a href="http://127\.0\.0\.1:9323"[\s\S]*?</a>"\)',
        'print_info("http://127.0.0.1:9323")',
        text,
        count=1,
    )

    path.write_text(text, encoding="utf-8")

    try:
        py_compile.compile(str(path), doraise=True)
    except Exception as error:
        path.write_text(original, encoding="utf-8")
        raise RuntimeError(
            "Update failed syntax validation. Original Test_AI.py was restored. "
            f"Details: {error}"
        ) from error

    print(f"Updated : {path.resolve()}")
    print(f"Backup  : {backup.resolve()}")
    print("Syntax  : PASSED")
    print("RCA     : prints once at the end, after notification")
    print("Other framework logic was preserved.")


if __name__ == "__main__":
    main()
